{
  "expo": {
    "name": "MoneyTracker",
    "slug": "MoneyTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moneytracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.moneytracker.personal",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.moneytracker.personal",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow MoneyTracker to unlock with Face ID."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow MoneyTracker to use Face ID for biometric unlock."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
